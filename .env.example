# ============================================
# AI Coding Mentor - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Groq API Key - Get yours at https://console.groq.com
GROQ_API_KEY=PASTE_YOUR_API_KEY_HERE

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/ai_coding_mentor
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ai_coding_mentor
MONGODB_URI=mongodb://localhost:27017/ai_coding_mentor

# Server Port (optional, defaults to 3000)
PORT=3000
